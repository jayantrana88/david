{
  "name": "david",
  "version": "0.1.0",
  "private": true,
  "description": "DAVID on Cloudflare's free tier: one Worker (a React dashboard served as static assets, a JSON API, and a cron tick that runs the stages), D1, Workers AI.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "deploy": "wrangler deploy",
    "db:migrations:apply": "wrangler d1 migrations apply DB --remote",
    "db:migrations:local": "wrangler d1 migrations apply DB --local",
    "typecheck": "wrangler types && tsc --noEmit && tsc --noEmit -p web && tsc --noEmit -p web/server",
    "test": "vitest run",
    "dashboard": "npm run build && tsx web/server/server.ts"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.72.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "^7.3.8",
    "vitest": "3.2.7",
    "wrangler": "4.157.0"
  },
  "cloudflare": {
    "bindings": {
      "DB": {
        "description": "The D1 database that holds everything: tasks, companies, applications, your profile and resume, settings."
      }
    }
  }
}
