// DAVID on Cloudflare (free plan). One Worker:
//   assets     the React dashboard (web/, built into web/dist): static files, free and unmetered
//   fetch      /api/* and /oauth/*: the dashboard's JSON API (optional password: set on the Settings page)
//   scheduled  every minute: one "tick" that runs one stage a small step (src/runner.ts)
// The Deploy to Cloudflare button provisions the D1 database (no database_id here: it is created and filled in for
// you) and Workers AI. The Worker applies migrations/ to D1 itself, so any deploy command works.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "david",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Serve the Worker on its *.workers.dev address (and its preview URLs) so a fresh deploy is reachable without
  // enabling the domain by hand in the Cloudflare dashboard.
  "workers_dev": true,
  "preview_urls": true,
  "observability": { "enabled": true },
  "triggers": { "crons": ["* * * * *"] },
  // The dashboard is a static React app. Only /api/* and /oauth/* reach the Worker (and its 10 ms of CPU); every other
  // address is a file, or index.html for the app's own routes. `npm run build` makes web/dist; wrangler runs it
  // before every deploy and `wrangler dev`, so any deploy command works.
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/oauth/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "david",
      "migrations_dir": "migrations"
    }
  ],
  "ai": { "binding": "AI" },
  // The migration files are bundled into the Worker as text (src/migrations.ts applies them on first run).
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }]
  // Browser Rendering is NOT bound here: Cloudflare's deploy screen refuses it on the free plan ("only available on
  // Workers Paid"). On a paid plan, add  "browser": { "binding": "BROWSER" }  and pick it in Settings → Sourcing.
}
